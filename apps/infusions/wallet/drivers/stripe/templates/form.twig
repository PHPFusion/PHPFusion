<div class="sr-root">
    <div class="sr-main">
        {{ form.openform|raw }}
        {{ form.payment_type|raw }}
        {{ form.payment_method|raw }}
        {{ form.payment_currency|raw }}
        {{ form.return_url|raw }}
        {{ form.order_items|raw }}
        <div class="sr-combo-inputs-row">
            <div class="sr-input sr-card-element" id="card-element"></div>
        </div>
        <div class="sr-field-error" id="card-errors" role="alert"></div>
        <div class="spacer-sm">
            <button id="submit" type="submit" class="btn btn-primary btn-md small text-expanded btn-block">
                <div class="spinner hidden" id="spinner"></div>
                <span id="button-text">Pay with Credit Card</span><span id="order-amount"></span>
            </button>
        </div>
        {{ form.closeform|raw }}
        <div id="stripe-response" class="sr-result hidden">
            <p>Payment completed<br/></p>
            <pre>
            <code></code>
          </pre>
        </div>
    </div>
</div>

